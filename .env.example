# Page Pulse URL Audit Service - Environment Configuration

# Server Port (Default: 3000)
PORT=3000

# Node Environment ('development' or 'production')
NODE_ENV=development

# Application URL (Auto-injected in AI Studio / Cloud Run)
APP_URL=https://ais-dev-jqy5z24h23j63erks6syi4-525209508268.asia-southeast1.run.app

# Redis Cache Connection URL (Falls back to in-memory cache if unavailable)
REDIS_URL=redis://localhost:6379

# Concurrency & Semaphore Limits
MAX_CONCURRENCY=500
MAX_QUEUE_LENGTH=1000

# Rate Limiting Configuration (Sliding Window per IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Audit Timeout Configuration in milliseconds
AUDIT_TIMEOUT_MS=5000

# Pino Logging Level ('debug', 'info', 'warn', 'error')
LOG_LEVEL=info

# Gemini API Key (Optional for AI-assisted audit summaries)
GEMINI_API_KEY=
